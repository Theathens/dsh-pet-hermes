# ── 依赖 ──────────────────────────────────────────────────────────────
# 由 npm install 生成，克隆后自行安装，不提交
node_modules/

# ── 构建产物 ──────────────────────────────────────────────────────────
# 由 npm run build (tsdown) 生成；源码仓库不提交，克隆者自行构建
lib/

# ── Python 缓存 ───────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo

# ── 密钥（Hermes API key）— 绝不提交 ──────────────────────────────────
# 插件运行时从插件根目录的 token.txt 读取 Hermes Bearer key
token.txt
*.env

# ── 系统 / 编辑器 / 日志 ───────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*.log
.idea/
.vscode/

# ── 隔离验证 / 临时产物 ────────────────────────────────────────────────
# playwright 截图等临时输出
.playwright-mcp/
